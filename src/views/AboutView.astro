---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Testimonial from '../components/Testimonial.astro';
import { defaultLang } from '../i18n/config';
import type { Lang } from '../i18n/config';
import { t } from '../i18n/ui';
import portrait from '../assets/about/portrait.jpg';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const ui = t(lang);
---

<Base title={ui.about.title} description={ui.about.description} lang={lang}>
  <main>
    <section class="page-hero wrap">
      <p class="label label--accent reveal">{ui.about.kicker}</p>
      <h1 class="reveal">{ui.about.heading}</h1>
    </section>

    <section class="wrap layout">
      <figure class="portrait reveal">
        <Image
          src={portrait}
          alt={ui.home.portraitAlt}
          widths={[400, 640]}
          sizes="(max-width: 860px) 100vw, 400px"
        />
        <figcaption>{ui.about.portraitCaption}</figcaption>
      </figure>

      <div>
        <div class="prose reveal">
          {ui.about.prose.map((para) => <p set:html={para} />)}
        </div>

        <div class="skills reveal">
          <p class="label label--accent">{ui.about.skillsKicker}</p>
          {
            ui.about.skills.map((skill) => (
              <div class="skill-row">
                <h3>{skill.title}</h3>
                <p>{skill.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="wrap reference" aria-label={ui.about.ariaReferences}>
      <div>
        <p class="label label--accent reveal">{ui.about.referencesKicker}</p>
        <div class="reference-cards">
          {
            ui.about.testimonials.map((item) => (
              <Testimonial quote={item.quote} cite={item.cite} />
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .page-hero {
    padding-block: calc(var(--space-section) * 0.55) var(--space-block);
  }

  .page-hero .label {
    margin-bottom: 1.4rem;
  }

  .page-hero h1 {
    font-size: var(--text-h1);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(16rem, 25rem) 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .portrait img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .portrait figcaption {
    font-size: 0.8rem;
    color: var(--ink-soft);
    padding-top: 0.7rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.7rem;
  }

  .prose p + p {
    margin-top: 1.1em;
  }

  .prose :global(strong) {
    font-weight: 500;
    color: var(--accent-ink);
  }

  .skills {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .skills .label {
    margin-bottom: 1.2rem;
  }

  .skill-row {
    display: grid;
    grid-template-columns: minmax(10rem, 16rem) 1fr;
    gap: 1rem 2rem;
    border-top: 1px solid var(--line-strong);
    padding-block: 1.1rem;
  }

  .skill-row h3 {
    font-size: 1.05rem;
  }

  .skill-row p {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .reference {
    margin-top: calc(var(--space-section) * 0.5);
  }

  .reference > div {
    border-top: 1px solid var(--ink);
    padding-top: 1.3rem;
  }

  .reference .label {
    margin-bottom: 1.4rem;
  }

  .reference-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
    align-items: start;
  }

  @media (max-width: 860px) {
    .reference-cards {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .skill-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
