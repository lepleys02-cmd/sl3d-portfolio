---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import ScrollScrub from '../components/ScrollScrub.astro';
import { getProjects, getCollections } from '../data/localized';
import { defaultLang, localizePath } from '../i18n/config';
import type { Lang } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  slug: string;
  lang?: Lang;
}

const { slug, lang = defaultLang } = Astro.props;
const ui = t(lang);

const projects = getProjects(lang);
const collections = getCollections(lang);
const project = projects.find((p) => p.slug === slug);
if (!project) throw new Error(`Unknown project slug "${slug}"`);

// Collection members cycle prev/next among their siblings and link back up to
// the hub; standalone projects cycle among the other standalone projects.
const parent = project.collection
  ? collections.find((c) => c.slug === project.collection)
  : undefined;
const ring = project.collection
  ? projects.filter((p) => p.collection === project.collection)
  : projects.filter((p) => !p.collection);
const ri = ring.findIndex((p) => p.slug === slug);
const prev = ring[(ri - 1 + ring.length) % ring.length];
const next = ring[(ri + 1) % ring.length];
const num = String(ri + 1).padStart(2, '0');
const total = String(ring.length).padStart(2, '0');

const allImages = import.meta.glob<{ default: ImageMetadata }>('../assets/**/*.jpg', {
  eager: true,
});
const projectImages = Object.entries(allImages)
  .filter(([path]) => path.includes(`/assets/${project.slug}/`))
  .sort(([a], [b]) => a.localeCompare(b));

// Before/after pairing: pulled out of the normal gallery flow. `pairs` lets a
// project be built entirely of comparisons; `process` is the one-pair case.
const pairDefs = project.pairs ?? (project.process ? [project.process] : []);
const findImage = (file: string) =>
  projectImages.find(([path]) => path.endsWith(`/${file}`))?.[1].default;
const resolvedPairs = pairDefs.map((def) => ({
  def,
  before: findImage(def.before),
  after: def.after ? findImage(def.after) : undefined,
}));
const processFiles = pairDefs
  .flatMap((def) => [def.before, def.after])
  .filter((f): f is string => Boolean(f));
// The still↔motion pair is its own section, so its seed still is held back
// from the gallery the same way process/pair images are.
const stillToMotion = project.stillToMotion;
const stillImage = stillToMotion ? findImage(stillToMotion.still) : undefined;
const heldBack = [...processFiles, ...(stillToMotion ? [stillToMotion.still] : [])];
const gallery = projectImages
  .filter(([path]) => !heldBack.some((file) => path.endsWith(`/${file}`)))
  .map(([, mod]) => mod.default);

// Drawing-led case studies pair each sorted sheet with its label + caption.
const sheetItems =
  project.documentation && project.sheets
    ? gallery.map((img, i) => ({ img, meta: project.sheets![i] }))
    : [];

// The scroll-feature clip gets its own pinned section above the plain grid —
// drop it from the grid list below so it doesn't appear twice.
const gridVideos = project.videos?.filter((src) => src !== project.scrollFeature?.video);
---

<Base
  title={`${project.title} ${ui.project.titleSuffix}`}
  description={`${project.title}: ${project.description}`}
  lang={lang}
>
  <main>
    <section class="project-hero wrap">
      <p class="label label--accent reveal">
        {
          parent ? (
            <>
              <a class="hub-back" href={localizePath(`/${parent.slug}`, lang)}>
                {parent.title}
              </a>{' '}
              &mdash; {project.discipline}
            </>
          ) : (
            <>
              {num} / {total} &mdash; {project.discipline}
            </>
          )
        }
      </p>
      <h1 class="reveal">{project.title}</h1>
      <p class="intro reveal">{project.description}</p>
      <dl class="facts reveal" data-count={project.facts.length}>
        {
          project.facts.map((fact) => (
            <div>
              <dt class="label">{fact.k}</dt>
              <dd>{fact.v}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      project.headerVideo && (
        <section class="header-media wrap reveal" aria-label={ui.project.ariaShowreel(project.title)}>
          <video
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            poster={project.headerVideo.replace('.mp4', '-poster.jpg')}
          >
            <source src={project.headerVideo} type="video/mp4" />
          </video>
        </section>
      )
    }

    {
      (project.brief || project.approach) && (
        <section class="case wrap" aria-label={ui.project.ariaCase}>
          {project.brief && (
            <div class="reveal">
              <p class="label label--accent">{ui.project.briefLabel}</p>
              <p>{project.brief}</p>
            </div>
          )}
          {project.approach && (
            <div class="reveal">
              <p class="label label--accent">{ui.project.approachLabel}</p>
              <p>{project.approach}</p>
            </div>
          )}
        </section>
      )
    }

    {
      resolvedPairs.map(
        (pair, pi) =>
          pair.before && (
            <section
              class="process wrap"
              aria-label={pair.after ? ui.project.ariaBeforeAfter : ui.project.ariaDrawingSet}
            >
              <div class:list={['process-pair', { 'process-pair--single': !pair.after }]}>
                <figure class="reveal">
                  <Image
                    src={pair.before}
                    alt={`${project.title} — ${pair.def.beforeLabel ?? ui.project.drawn}`}
                    widths={[640, 1080, 1600]}
                    sizes={
                      pair.after ? '(max-width: 900px) 100vw, 46vw' : '(max-width: 900px) 100vw, 960px'
                    }
                    loading={pi === 0 ? 'eager' : 'lazy'}
                  />
                  <figcaption class="label">{pair.def.beforeLabel ?? ui.project.drawn}</figcaption>
                </figure>
                {pair.after && (
                  <figure class="reveal">
                    <Image
                      src={pair.after}
                      alt={`${project.title} — ${pair.def.afterLabel ?? ui.project.rendered}`}
                      widths={[640, 1080, 1600]}
                      sizes="(max-width: 900px) 100vw, 46vw"
                      loading={pi === 0 ? 'eager' : 'lazy'}
                    />
                    <figcaption class="label">{pair.def.afterLabel ?? ui.project.rendered}</figcaption>
                  </figure>
                )}
              </div>
              <p class="process-caption reveal">{pair.def.caption}</p>
            </section>
          )
      )
    }

    {
      stillToMotion && stillImage && (
        <section class="process wrap" aria-label={ui.project.ariaStillMotion}>
          <div class="process-pair still-motion">
            <figure class="reveal">
              <Image
                src={stillImage}
                alt={ui.project.altSourceStill(project.title)}
                widths={[640, 1080, 1600]}
                sizes="(max-width: 900px) 100vw, 46vw"
                loading="eager"
              />
              <figcaption class="label">{stillToMotion.stillLabel ?? ui.project.still}</figcaption>
            </figure>
            <figure class="reveal">
              <video
                data-motion
                muted
                loop
                playsinline
                preload="none"
                poster={stillToMotion.video.replace('.mp4', '-poster.jpg')}
                aria-label={ui.project.altMotionClip(project.title)}
              >
                <source src={stillToMotion.video} type="video/mp4" />
              </video>
              <figcaption class="label">
                <span class="live" aria-hidden="true" />
                {stillToMotion.motionLabel ?? ui.project.motion}
              </figcaption>
            </figure>
          </div>
          <p class="process-caption reveal">{stillToMotion.caption}</p>
        </section>
      )
    }

    {
      project.documentation && sheetItems.length > 0 ? (
        <section class="gallery gallery--sheets wrap" aria-label={ui.project.ariaSheets(project.title)}>
          {sheetItems.map(({ img, meta }, i) => (
            <figure class="sheet reveal">
              <div class="sheet-frame">
                <Image
                  src={img}
                  alt={
                    meta
                      ? `${project.title} — ${meta.label}`
                      : ui.project.altSheet(project.title, i + 1)
                  }
                  widths={[640, 1080, 1600, 2000]}
                  sizes="(max-width: 900px) 100vw, 92vw"
                  loading={i < 1 ? 'eager' : 'lazy'}
                />
              </div>
              {meta && (
                <figcaption>
                  <span class="sheet-label">{meta.label}</span>
                  <span class="sheet-note">{meta.caption}</span>
                </figcaption>
              )}
            </figure>
          ))}
        </section>
      ) : (
        gallery.length > 0 && (
          <section class="gallery wrap" aria-label={ui.project.ariaGallery(project.title)}>
            {gallery.map((img, i) => (
              <figure class="reveal">
                <Image
                  src={img}
                  alt={ui.project.altGallery(project.title, i + 1)}
                  widths={[640, 1080, 1600, 2000]}
                  sizes="(max-width: 900px) 100vw, 92vw"
                  loading={i < 1 ? 'eager' : 'lazy'}
                />
              </figure>
            ))}
          </section>
        )
      )
    }

    {
      project.scrollFeature && (
        <ScrollScrub
          video={project.scrollFeature.video}
          poster={project.scrollFeature.poster}
          chapters={project.scrollFeature.chapters}
          lang={lang}
        />
      )
    }

    {
      gridVideos && gridVideos.length > 0 && (
        <section class="videos wrap" aria-label={ui.project.ariaVideos(project.title)}>
          {gridVideos.map((src) => (
            <figure class="reveal">
              {/* eslint-disable-next-line */}
              <video
                controls
                muted
                loop
                playsinline
                preload="metadata"
                data-motion
                poster={src.replace('.mp4', '-poster.jpg')}
              >
                <source src={src} type="video/mp4" />
              </video>
            </figure>
          ))}
        </section>
      )
    }

    <nav class="project-nav wrap" aria-label={ui.project.ariaNav}>
      <a href={localizePath(`/work/${prev.slug}`, lang)}>
        <span class="label">{ui.project.prev}</span>
        <span class="name">{prev.title}</span>
      </a>
      <a href={localizePath(`/work/${next.slug}`, lang)} class="next">
        <span class="label">{ui.project.next}</span>
        <span class="name">{next.title}</span>
      </a>
    </nav>
  </main>
</Base>

<style>
  .project-hero {
    padding-block: calc(var(--space-section) * 0.55) var(--space-block);
  }

  .project-hero .label {
    margin-bottom: 1.4rem;
  }

  .hub-back {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) ease;
  }

  .hub-back:hover {
    border-bottom-color: currentColor;
  }

  .project-hero h1 {
    font-size: var(--text-h1);
  }

  .intro {
    max-width: var(--max-prose);
    color: var(--ink-soft);
    margin-top: 1.4rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 14rem));
    gap: 1.5rem;
    margin-top: var(--space-block);
  }

  .facts[data-count='2'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .facts div {
    border-top: 1px solid var(--line-strong);
    padding-top: 0.8rem;
  }

  .facts dd {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-weight: 500;
  }

  .header-media {
    margin-bottom: var(--space-block);
  }

  .header-media video {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--ink);
  }

  .case {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    margin-bottom: var(--space-block);
  }

  .case .label {
    margin-bottom: 0.8rem;
  }

  .case p:not(.label) {
    max-width: 36rem;
    color: var(--ink-soft);
  }

  .process {
    margin-bottom: var(--space-block);
  }

  .process-pair {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    align-items: center;
  }

  .process-pair figure {
    margin: 0;
  }

  /* Drawing-only variant: one sheet, centered and noticeably larger than its
     old half-width slot in the pair. */
  .process-pair--single {
    grid-template-columns: 1fr;
  }

  .process-pair--single figure {
    max-width: 60rem;
    margin-inline: auto;
    width: 100%;
  }

  .process-pair img {
    width: 100%;
    border: 1px solid var(--line);
  }

  .process-pair figcaption {
    margin-top: 0.7rem;
  }

  /* Still ↔ motion: the two halves have to sit in identical frames, or the
     eye reads "two shots" instead of "one shot, frozen and running". Both
     sources are square, so the slot is square and both are cropped the same
     way; the pair aligns at the top rather than centring on differing
     intrinsic heights. */
  .still-motion {
    align-items: start;
  }

  .still-motion figure {
    margin: 0;
    min-width: 0;
  }

  .still-motion img,
  .still-motion video {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .still-motion figcaption {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 0.7rem;
  }

  /* One accent tick so the moving half is identifiable even in a screenshot. */
  .still-motion .live {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--accent);
  }

  .process-caption {
    margin-top: 1.2rem;
    max-width: var(--max-prose);
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  /* Editorial rhythm: one full-bleed image, then a two-up pair */
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    align-items: start;
  }

  .gallery figure:nth-child(3n + 1) {
    grid-column: 1 / -1;
  }

  .gallery img {
    width: 100%;
  }

  /* Drawing-led projects: each sheet matted on paper with a hairline frame,
     a sheet label and a one-line curatorial note — reads as documentation,
     not a photo gallery. Shares the .gallery grid + full-bleed rhythm. */
  .gallery--sheets {
    align-items: start;
    row-gap: clamp(2rem, 4vw, 3.5rem);
  }

  .sheet {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .sheet-frame {
    background: var(--surface);
    border: 1px solid var(--line-strong);
    padding: clamp(0.7rem, 1.8vw, 1.6rem);
  }

  .sheet-frame img {
    width: 100%;
    display: block;
  }

  .gallery--sheets figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.85rem;
  }

  .sheet-label {
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .sheet-note {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  .videos {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  /* Every clip fills the 16:9 frame edge to edge (square sources are
     centre-cropped by object-fit) — no pillarbox mats. The surface tone only
     shows for an instant while the poster loads. */
  .videos video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--surface);
    border: 1px solid var(--line-strong);
  }

  .project-nav {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid var(--ink);
    margin-top: var(--space-section);
    padding-top: 1.4rem;
  }

  .project-nav a {
    display: grid;
    gap: 0.4rem;
  }

  .project-nav .next {
    text-align: right;
  }

  .project-nav .name {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: var(--text-h3);
    transition: color var(--duration-fast) ease;
  }

  .project-nav a:hover .name {
    color: var(--accent-ink);
  }

  @media (max-width: 720px) {
    .gallery {
      grid-template-columns: 1fr;
    }

    .case,
    .process-pair {
      grid-template-columns: 1fr;
    }

    .gallery figure:nth-child(3n + 1) {
      grid-column: auto;
    }

    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Fact values are full sentences, not labels — two ~140px columns can't
     hold them on a phone in any language, and Dutch compounds overflow it
     outright. One column below 480px. */
  @media (max-width: 480px) {
    .facts,
    .facts[data-count='2'] {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Grid clips play muted on their own while in view (paused again offscreen)
  // instead of sitting as static posters behind a play button — same IO
  // conventions as ShowcaseTile / ScrollScrub. Controls stay for scrubbing
  // and fullscreen; a visitor's explicit pause is respected until the clip
  // leaves and re-enters the viewport. Reduced-motion users keep the
  // poster + controls behaviour untouched.
  let gridVideoIO: IntersectionObserver | null = null;

  function initGridVideos() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const videos = document.querySelectorAll<HTMLVideoElement>(
      '.videos video[data-motion]:not([data-wired])'
    );
    if (!videos.length) return;

    if (!('IntersectionObserver' in window)) {
      videos.forEach((v) => {
        v.dataset.wired = 'true';
        v.play().catch(() => {});
      });
      return;
    }

    gridVideoIO ??= new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (v.dataset.userPaused !== 'true') v.play().catch(() => {});
          } else {
            v.pause();
            delete v.dataset.userPaused;
          }
        }
      },
      { threshold: 0.3 }
    );

    videos.forEach((v) => {
      v.dataset.wired = 'true';
      // A pause while the clip is (still) on screen came from the visitor,
      // not from this observer — remember it so we don't fight their click.
      v.addEventListener('pause', () => {
        if (!v.ended && v.dataset.wired === 'true') {
          const rect = v.getBoundingClientRect();
          const inView = rect.bottom > 0 && rect.top < window.innerHeight;
          if (inView) v.dataset.userPaused = 'true';
        }
      });
      gridVideoIO!.observe(v);
    });
  }

  // The still↔motion half plays itself, with no controls: the point of the
  // pair is a frozen frame beside the same frame running, and a play button
  // on one side breaks that read. Same IO + reduced-motion conventions as
  // ShowcaseTile — reduced-motion users are left with the poster, which is
  // the seed still anyway, so the pair degrades to two matching frames.
  let stillMotionIO: IntersectionObserver | null = null;

  function initStillMotion() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const videos = document.querySelectorAll<HTMLVideoElement>(
      '.still-motion video[data-motion]:not([data-wired])'
    );
    if (!videos.length) return;

    if (!('IntersectionObserver' in window)) {
      videos.forEach((v) => {
        v.dataset.wired = 'true';
        v.play().catch(() => {});
      });
      return;
    }

    stillMotionIO ??= new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { threshold: 0.35 }
    );

    videos.forEach((v) => {
      v.dataset.wired = 'true';
      stillMotionIO!.observe(v);
    });
  }

  document.addEventListener('astro:page-load', initGridVideos);
  document.addEventListener('astro:page-load', initStillMotion);
</script>
