---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CollectionCard from '../components/CollectionCard.astro';
import ShowcaseTile from '../components/ShowcaseTile.astro';
import NumbersStrip from '../components/NumbersStrip.astro';
import { getProjects, getCollections } from '../data/localized';
import type { Project, Collection } from '../data/localized';
import { defaultLang, localizePath } from '../i18n/config';
import type { Lang } from '../i18n/config';
import { t } from '../i18n/ui';
import portrait from '../assets/about/portrait.jpg';

// Curated best-of pieces (imported so astro:assets can size/optimise them).
import drawnSheet from '../assets/archviz/04.jpg';
import renderedStreet from '../assets/archviz/01.jpg';
import lakesideVeranda from '../assets/nubuiten/13.jpg';
import norwayTerrace from '../assets/nubuiten/norway-terrace.jpg';
import pergolaRegrade from '../assets/ai-revival/garden40-after.jpg';
import bedroomUpgrade from '../assets/park24-bulkheads/02.jpg';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const ui = t(lang);
const projects = getProjects(lang);
const collections = getCollections(lang);

const covers = import.meta.glob<{ default: ImageMetadata }>('../assets/covers/*.jpg', {
  eager: true,
});

function coverFor(slug: string): ImageMetadata {
  const entry = covers[`../assets/covers/${slug}.jpg`];
  if (!entry) throw new Error(`Missing cover image for project "${slug}"`);
  return entry.default;
}

// Collection members are grouped behind one hub card each so they don't
// scatter across the grid. Order: product/environment work → architecture
// hub → animation → AI hub, keeping wide cards at the top and bottom.
const architecture = collections.find((c) => c.slug === 'architecture')!;
const ai = collections.find((c) => c.slug === 'ai')!;
const memberCount = (slug: string) => projects.filter((p) => p.collection === slug).length;
const singles = projects.filter((p) => !p.collection);
type HomeItem =
  | { kind: 'project'; project: Project }
  | { kind: 'collection'; collection: Collection };
const homeItems: HomeItem[] = [
  ...singles.slice(0, 2).map((project): HomeItem => ({ kind: 'project', project })),
  { kind: 'collection', collection: architecture },
  ...singles.slice(2).map((project): HomeItem => ({ kind: 'project', project })),
  { kind: 'collection', collection: ai },
];
---

<Base title={ui.home.title} description={ui.home.description} lang={lang}>
  <main>
    <!-- Statement hero (UNStudio pattern): type first, image after -->
    <section class="hero wrap" aria-label={ui.home.ariaIntro}>
      <p class="label label--accent reveal">{ui.home.kicker}</p>
      <h1 class="reveal">SL3D<sup class="brand-mark">&#9650;</sup></h1>
      <div class="hero-row reveal">
        <div>
          <p>{ui.home.tagline}</p>
          <p class="hero-sub">{ui.home.heroSub}</p>
        </div>
        <a class="arrow-link" href={localizePath('/#work', lang)}>{ui.home.selectedWorkLink}</a>
      </div>
    </section>

    <section class="hero-media wrap reveal" aria-label={ui.home.ariaShowreel}>
      <div class="reel">
        <video
          class="hero-video"
          muted
          loop
          playsinline
          preload="auto"
          width="1920"
          height="1080"
          poster="/video/hero-reel-v12-poster.jpg"
        >
          <!-- Rebuilt from the source stills at 60fps with an exact sub-pixel
               Ken Burns zoom. v4/v5 were composited with ffmpeg's zoompan,
               whose crop window is computed in WHOLE pixels: on a slow zoom it
               holds 3-4 frames then jumps, a ~0.5px sawtooth at 6-7Hz that read
               as stutter and was glaring on the 2D drawings. v7 also resamples
               with Lanczos-3 rather than a triangle filter, which had left the
               reel looking soft and upscaled.
               v9 swaps the opening shot: the reel used to open on an AI
               regrade (ai-revival/after.jpg, painterly-soft) which made the
               whole reel read as "AI-upscaled" from the first frame — and the
               poster with it. It now opens on the pure-CGI nubuiten/01
               garden room (~7x the measured texture detail), with a slightly
               richer encode (crf 19 / maxrate 8500k) for the linework.
               v10 replaces shot 3: the frozen product-anim video grab (the
               softest source in the reel) gives way to the Sussex 2
               exploded-view hero still, a native 4K render; v11 warm-graded that
               still by eye (per-channel gains) so it sat with the other shots.
               v12 drops that guesswork: the still is rebuilt from the render's
               own alpha, compositing the product over the same paper plate the
               explosion films now use, so the shot matches them exactly rather
               than approximately. Do not re-add a grade here — the plate is set
               upstream in regrade_explosion_frames.py and would double up.
               Phones get the 720p cut - browsers pick the first matching
               <source>, so the narrow query must come first. -->
          <source src="/video/hero-reel-v12-720.mp4" type="video/mp4" media="(max-width: 720px)" />
          <source src="/video/hero-reel-v12.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="reel-cap">
        <span class="label">{ui.home.showreel}</span>
        <span class="reel-meta">{ui.home.showreelMeta}</span>
      </div>
    </section>

    <!-- Curated best-of mix: drawn, rendered, moving -->
    <section class="section wrap showcase" id="showcase" aria-labelledby="showcase-heading">
      <div class="section-head reveal">
        <h2 id="showcase-heading">{ui.home.showcaseHeading}</h2>
      </div>
      <p class="showcase-lede reveal">{ui.home.showcaseLede}</p>

      <!-- The pairing: one model, two deliverables -->
      <p class="pair-caption reveal"><strong>{ui.home.capApple}</strong></p>
      <div class="pair reveal" aria-label={ui.home.ariaPair}>
        <ShowcaseTile
          discipline={ui.home.disciplines.drawing}
          kind="drawing"
          lang={lang}
          title={ui.home.tiles.sheet.title}
          ratio="4 / 3"
          image={drawnSheet}
          alt={ui.home.tiles.sheet.alt}
          widths={[520, 900, 1400]}
          sizes="(max-width: 860px) 100vw, 46vw"
          eager={true}
          note={ui.home.tiles.sheet.note}
        />
        <span class="pair-seam" aria-hidden="true">
          <span class="pair-seam-line"></span>
          <span class="pair-seam-tag" set:html={ui.home.seamPair} />
          <span class="pair-seam-line"></span>
        </span>
        <ShowcaseTile
          discipline={ui.home.disciplines.render}
          kind="render"
          lang={lang}
          title={ui.home.tiles.street.title}
          ratio="4 / 3"
          image={renderedStreet}
          alt={ui.home.tiles.street.alt}
          widths={[520, 900, 1400]}
          sizes="(max-width: 860px) 100vw, 46vw"
          eager={true}
          note={ui.home.tiles.street.note}
        />
      </div>

      <!-- Bento of the rest: varied scale, alternating weight -->
      <div class="bento">
        <p class="pair-caption pair-caption--tight reveal"><strong>{ui.home.capLife}</strong></p>
        <div class="bento-row bento-row--a">
          <ShowcaseTile
            discipline={ui.home.disciplines.render}
            kind="render"
            lang={lang}
            title={ui.home.tiles.veranda.title}
            ratio="16 / 9"
            image={lakesideVeranda}
            alt={ui.home.tiles.veranda.alt}
            widths={[640, 1000, 1500]}
            sizes="(max-width: 860px) 100vw, 46vw"
            note={ui.home.tiles.veranda.note}
          />
          <span class="pair-seam" aria-hidden="true">
            <span class="pair-seam-line"></span>
            <span class="pair-seam-tag" set:html={ui.home.seamMotion} />
            <span class="pair-seam-line"></span>
          </span>
          <ShowcaseTile
            discipline={ui.home.disciplines.animation}
            kind="animation"
            lang={lang}
            title={ui.home.tiles.verandaMotion.title}
            ratio="16 / 9"
            video="/video/product-anim-04-v2.mp4"
            poster="/video/product-anim-04-v2-poster.jpg"
            note={ui.home.tiles.verandaMotion.note}
          />
        </div>
        <p class="pair-caption pair-caption--tight reveal">
          <strong>{ui.home.capAtmosphere}</strong>
        </p>
        <div class="bento-row bento-row--b">
          <ShowcaseTile
            discipline={ui.home.disciplines.render}
            kind="render"
            lang={lang}
            title={ui.home.tiles.norway.title}
            ratio="4 / 3"
            image={norwayTerrace}
            alt={ui.home.tiles.norway.alt}
            widths={[640, 1000, 1500]}
            sizes="(max-width: 860px) 100vw, 90vw"
            note={ui.home.tiles.norway.note}
          />
        </div>

        <p class="pair-caption pair-caption--tight reveal"><strong>{ui.home.capAiEnhance}</strong></p>
        <div class="bento-row bento-row--b">
          <ShowcaseTile
            discipline={ui.home.disciplines.aiRegrade}
            kind="render"
            lang={lang}
            title={ui.home.tiles.pergola.title}
            ratio="4 / 3"
            image={pergolaRegrade}
            alt={ui.home.tiles.pergola.alt}
            widths={[640, 1000, 1500]}
            sizes="(max-width: 860px) 100vw, 90vw"
            focus="50% 25%"
            note={ui.home.tiles.pergola.note}
          />
        </div>

        <p class="pair-caption pair-caption--tight reveal"><strong>{ui.home.capAiUpgrade}</strong></p>
        <div class="bento-row bento-row--b">
          <ShowcaseTile
            discipline={ui.home.disciplines.aiUpgrade}
            kind="render"
            lang={lang}
            title={ui.home.tiles.bedroom.title}
            ratio="4 / 3"
            image={bedroomUpgrade}
            alt={ui.home.tiles.bedroom.alt}
            widths={[640, 1000, 1500]}
            sizes="(max-width: 860px) 100vw, 90vw"
            note={ui.home.tiles.bedroom.note}
          />
        </div>
      </div>
    </section>

    <!-- Selected work: editorial rhythm — full, half/half, full -->
    <section class="section wrap" id="work" aria-labelledby="work-heading">
      <div class="section-head reveal">
        <h2 id="work-heading">{ui.home.workHeading}</h2>
      </div>
      <div class="work-grid">
        {
          homeItems.map((item, i) =>
            item.kind === 'project' ? (
              <ProjectCard
                project={item.project}
                index={i}
                cover={coverFor(item.project.slug)}
                wide={i === 0}
                lang={lang}
              />
            ) : (
              <CollectionCard
                collection={item.collection}
                index={i}
                cover={coverFor(item.collection.slug)}
                count={memberCount(item.collection.slug)}
                wide={i === 0}
                lang={lang}
              />
            )
          )
        }
      </div>
    </section>

    <!-- Third-party proof: one employer reference pulled up from /about -->
    <section class="section wrap" aria-label={ui.home.ariaReference}>
      <figure class="pull-quote reveal">
        <blockquote set:html={ui.home.pullQuote} />
        <figcaption>
          {ui.home.pullQuoteCite} &middot;
          <a href={localizePath('/about', lang)}>{ui.home.allReferences}</a>
        </figcaption>
      </figure>
    </section>

    <!-- Process strip (Vision Scapes pattern) -->
    <section class="section wrap" aria-labelledby="process-heading">
      <div class="section-head reveal">
        <h2 id="process-heading">{ui.home.processHeading}</h2>
      </div>
      <ol class="steps">
        {
          ui.home.steps.map((step, i) => (
            <li class="reveal">
              <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <NumbersStrip lang={lang} />

    <!-- About strip -->
    <section class="section wrap" aria-label={ui.home.ariaAbout}>
      <div class="about-strip reveal">
        <Image
          src={portrait}
          alt={ui.home.portraitAlt}
          widths={[320, 500]}
          sizes="(max-width: 720px) 40vw, 220px"
        />
        <div>
          <p class="label label--accent">{ui.home.aboutKicker}</p>
          <blockquote set:html={ui.home.aboutQuote} />
          <a class="arrow-link" href={localizePath('/about', lang)}>{ui.home.aboutLink}</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero {
    padding-block: calc(var(--space-section) * 0.7) calc(var(--space-section) * 0.45);
  }

  .hero .label {
    margin-bottom: 1.6rem;
  }

  .hero h1 {
    font-size: var(--text-hero);
    max-width: 12ch;
  }

  .hero h1 .brand-mark {
    font-size: 0.32em;
    color: var(--accent-ink);
    vertical-align: super;
    letter-spacing: 0;
  }

  .hero-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(1.8rem, 4vw, 3.2rem);
  }

  .hero-row p {
    max-width: 34rem;
    color: var(--ink-soft);
  }

  .hero-sub {
    margin-top: 0.6rem;
    font-size: 0.92rem;
    max-width: 38rem;
  }

  /* Showreel band — the montage shown FULL FRAME (16:9, nothing cropped),
     matted in generous paper and closed with a caption so it reads composed. */
  .hero-media {
    padding-block: 0 calc(var(--space-section) * 0.5);
  }

  .reel {
    width: min(100%, 84rem);
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    background: var(--line);
    border: 1px solid var(--line-strong);
    overflow: hidden;
  }

  .reel .hero-video {
    width: 100%;
    height: 100%;
    object-fit: contain; /* full frame — the whole 1920×1080 montage stays visible */
    display: block;
  }

  .reel-cap {
    width: min(100%, 84rem);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
    padding-top: 0.8rem;
  }

  .reel-meta {
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }

  /* ---------- Curated best-of mix ---------- */
  .showcase-lede {
    max-width: 46ch;
    margin-top: calc(var(--space-block) * -0.4);
    margin-bottom: var(--space-block);
    color: var(--ink-soft);
    font-size: var(--text-h3);
    line-height: 1.4;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    margin-bottom: var(--space-block);
  }

  .pair-seam {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    align-self: stretch;
    padding-block: 2.5rem;
  }

  .pair-seam-line {
    flex: 1;
    width: 1px;
    background: var(--line-strong);
  }

  .pair-seam-tag {
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
    text-align: center;
    line-height: 1.5;
    white-space: nowrap;
  }

  .pair-caption {
    margin-bottom: 1rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .pair-caption--tight {
    margin-bottom: 0;
  }

  .pair-caption strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* Bento: alternating feature weight, deliberately uneven scale. */
  .bento {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }

  .bento-row {
    display: grid;
    align-items: start;
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
  }

  .bento-row--a {
    grid-template-columns: 1fr auto 1fr;
  }

  .bento-row--b {
    grid-template-columns: 1fr;
  }

  .bento-row--c {
    grid-template-columns: 1fr 1fr;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3.5vw, 3.5rem) clamp(1.25rem, 2.5vw, 2.5rem);
  }

  .pull-quote {
    margin: 0;
    border-top: 1px solid var(--ink);
    padding-top: var(--space-block);
  }

  .pull-quote blockquote {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 560;
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 34ch;
    text-wrap: balance;
    margin: 0;
  }

  .pull-quote :global(em) {
    font-style: normal;
    color: var(--accent-ink);
  }

  .pull-quote figcaption {
    margin-top: 1.4rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .pull-quote figcaption a:hover {
    color: var(--accent-ink);
  }

  .work-grid > :global(.card--wide) {
    grid-column: 1 / -1;
  }

  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .steps li {
    position: relative;
    border-top: 1px solid var(--line-strong);
    padding-top: 1.1rem;
  }

  /* Accent line draws left-to-right over the hairline track once the step
     becomes visible; each step's delay is staggered so it reads as one line
     travelling Measured → Marketable. Tick-dot sits at the leading edge and
     fills solid right as its step's draw completes. */
  .steps li::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-slow) var(--ease-out);
    transition-delay: 150ms;
  }

  .steps li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--line-strong);
    transform: translate(-50%, -50%);
    transition: background var(--duration-fast) var(--ease-out);
    transition-delay: 150ms;
  }

  .steps li.is-visible::after {
    transform: scaleX(1);
  }

  .steps li.is-visible::before {
    background: var(--accent);
    transition-delay: calc(150ms + var(--duration-slow));
  }

  .steps li:nth-child(2)::after,
  .steps li:nth-child(2)::before {
    transition-delay: 350ms;
  }

  .steps li:nth-child(2).is-visible::before {
    transition-delay: calc(350ms + var(--duration-slow));
  }

  .steps li:nth-child(3)::after,
  .steps li:nth-child(3)::before {
    transition-delay: 550ms;
  }

  .steps li:nth-child(3).is-visible::before {
    transition-delay: calc(550ms + var(--duration-slow));
  }

  .step-num {
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
  }

  .steps h3 {
    font-size: var(--text-h3);
    margin-block: 0.5rem 0.6rem;
  }

  .steps p {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .about-strip {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    border-top: 1px solid var(--ink);
    padding-top: var(--space-block);
  }

  .about-strip img {
    width: clamp(8rem, 18vw, 13.75rem);
    aspect-ratio: 1;
    object-fit: cover;
    flex-shrink: 0;
  }

  .about-strip blockquote {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 560;
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 26ch;
    margin-block: 0.9rem 1.4rem;
  }

  .about-strip :global(em) {
    color: var(--accent-ink);
    font-style: normal;
  }

  /* Bento collapses to a single readable column on small screens; the pair
     itself stacks internally (see CompareSplit's own 860px breakpoint). */
  @media (max-width: 860px) {
    .pair {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .pair-seam {
      flex-direction: row;
      padding-block: 0;
      gap: 0.9rem;
    }

    .pair-seam-line {
      width: auto;
      height: 1px;
      flex: 1;
    }

    .pair-seam-tag {
      white-space: normal;
    }

    .bento-row--a,
    .bento-row--b,
    .bento-row--c {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .work-grid,
    .steps {
      grid-template-columns: 1fr;
    }

    .about-strip {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (min-width: 721px) and (max-width: 1023px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .steps li::after {
      transform: scaleX(1);
      transition: none;
    }

    .steps li::before {
      background: var(--accent);
      transition: none;
    }
  }
</style>

<script>
  // Hero loop: autoplay only when the user hasn't asked for reduced motion.
  // Without JS (or with reduced motion) the poster frame stands in.
  document.addEventListener('astro:page-load', () => {
    const video = document.querySelector<HTMLVideoElement>('.hero-video');
    if (!video) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    video.play().catch(() => {
      /* Autoplay blocked — poster remains, which is fine. */
    });
  });
</script>
