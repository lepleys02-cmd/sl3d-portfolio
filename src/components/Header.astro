---
import { languages, defaultLang, localizePath, toRootPath, alternatesFor } from '../i18n/config';
import type { Lang } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  currentPath: string;
  lang?: Lang;
}

const { currentPath, lang = defaultLang } = Astro.props;
const ui = t(lang);

// Active state is judged on the locale-stripped path so /nl/about highlights
// the same item /about does.
const rootPath = toRootPath(currentPath);

const links = [
  { href: localizePath('/#work', lang), label: ui.nav.work, active: rootPath.startsWith('/work') },
  { href: localizePath('/about', lang), label: ui.nav.about, active: rootPath.startsWith('/about') },
  {
    href: localizePath('/contact', lang),
    label: ui.nav.contact,
    active: rootPath.startsWith('/contact'),
  },
];

// The switcher points at the SAME page in the other locale, not at its home —
// a language toggle that dumps you on the home page loses the reader's place.
const switcher = alternatesFor(currentPath).map((alt) => ({
  ...alt,
  meta: languages[alt.lang],
  current: alt.lang === lang,
}));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={localizePath('/', lang)}>SL3D<sup>&#9650;</sup></a>
    <div class="right">
      <nav aria-label={ui.nav.ariaMain}>
        {
          links.map((link) => (
            <a href={link.href} aria-current={link.active ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
      <nav class="lang" aria-label={ui.nav.ariaLanguage}>
        {
          switcher.map((alt) =>
            alt.current ? (
              <span class="is-current" lang={alt.meta.htmlLang} aria-current="true">
                {alt.meta.short}
              </span>
            ) : (
              <a
                href={alt.path}
                lang={alt.meta.htmlLang}
                hreflang={alt.meta.hreflang}
                title={ui.nav.switchTo}
              >
                {alt.meta.short}
              </a>
            )
          )
        }
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
  }

  .brand sup {
    color: var(--accent);
    font-size: 0.55em;
    margin-left: 0.15em;
  }

  .right {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.25rem);
  }

  nav {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  /* Language toggle reads as one small unit, set apart from the main nav by a
     hairline rather than more whitespace — the bar is already tight at 320px. */
  .lang {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding-left: clamp(0.7rem, 2vw, 1.25rem);
    border-left: 1px solid var(--line-strong);
  }

  .lang a,
  .lang .is-current {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    padding-block: 0.35rem;
    border-bottom: 1px solid transparent;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .lang a {
    color: var(--ink-soft);
    opacity: 0.65;
  }

  .lang a:hover {
    color: var(--ink);
    opacity: 1;
    border-color: var(--line-strong);
  }

  .lang .is-current {
    color: var(--ink);
    border-color: var(--accent);
  }

  @media (max-width: 520px) {
    .right,
    nav {
      gap: 0.85rem;
    }

    .lang {
      padding-left: 0.7rem;
    }
  }

  nav a {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    padding-block: 0.35rem;
    border-bottom: 1px solid transparent;
    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  nav a:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    border-color: var(--accent);
  }
</style>
