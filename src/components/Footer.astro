---
import SoftwareMarquee from './SoftwareMarquee.astro';
import { defaultLang, localizePath } from '../i18n/config';
import type { Lang } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  compact?: boolean;
  lang?: Lang;
}

const { compact = false, lang = defaultLang } = Astro.props;
const ui = t(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  {
    !compact && (
      <div class="wrap cta reveal">
        <p class="label label--accent">{ui.footer.kicker}</p>
        <h2>
          {ui.footer.headingLead}{' '}
          <a href={localizePath('/contact', lang)}>{ui.footer.headingLink}</a>
        </h2>
        <p class="availability">{ui.footer.availability}</p>
      </div>
    )
  }
  <SoftwareMarquee lang={lang} />
  <div class="wrap bar">
    <span>
      &copy; {year} Sam Lepley &mdash; SL3D &middot; {ui.footer.locality} &middot; KVK 42131264
    </span>
    <div class="links">
      <a href="/SL3D-Portfolio.pdf" download>{ui.footer.portfolioPdf}</a>
      <a href="mailto:sam@sl3d.net">sam@sl3d.net</a>
      <a href="https://www.linkedin.com/in/sam-lepley-7389b0180/" target="_blank" rel="noopener">
        LinkedIn
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: calc(var(--space-section) / 2);
    border-top: 1px solid var(--ink);
  }

  .cta {
    padding-block: var(--space-section);
  }

  .cta .label {
    margin-bottom: 1.2rem;
  }

  .cta h2 {
    font-size: var(--text-h1);
    max-width: 20ch;
  }

  .cta a {
    color: var(--accent-ink);
    border-bottom: 3px solid var(--accent);
    transition: color var(--duration-fast) ease;
  }

  .cta a:hover {
    color: var(--ink);
  }

  .availability {
    margin-top: 1.4rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-block: 1.4rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }

  .links a:hover {
    color: var(--accent-ink);
  }
</style>
