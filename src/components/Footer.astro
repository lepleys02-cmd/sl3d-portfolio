---
import SoftwareMarquee from './SoftwareMarquee.astro';
import { defaultLang, localizePath } from '../i18n/config';
import type { Lang } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  compact?: boolean;
  lang?: Lang;
}

const { compact = false, lang = defaultLang } = Astro.props;
const ui = t(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  {
    !compact && (
      <div class="wrap cta reveal">
        <h2>{ui.footer.headingLead}</h2>
        <p class="cta-action">
          <a class="arrow-link" href={localizePath('/contact', lang)}>{ui.footer.headingLink}</a>
        </p>
        <p class="availability">{ui.footer.availability}</p>
      </div>
    )
  }
  <SoftwareMarquee lang={lang} />
  <div class="wrap bar">
    <span class="legal">
      <span>&copy; {year} Sam Lepley, SL3D</span>
      <span>KVK&nbsp;42131264</span>
      <span>BTW&nbsp;NL005520384B17</span>
    </span>
    <div class="links">
      <a href={localizePath('/terms', lang)}>{ui.footer.terms}</a>
      <a href={localizePath('/privacy', lang)}>{ui.footer.privacy}</a>
      <a href="/SL3D-Portfolio.pdf" download>{ui.footer.portfolioPdf}</a>
      <a href="mailto:sam@sl3d.net">sam@sl3d.net</a>
      <a href="https://www.linkedin.com/in/sam-lepley-7389b0180/" target="_blank" rel="noopener">
        LinkedIn
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: calc(var(--space-section) / 2);
    border-top: 1px solid var(--ink);
  }

  .cta {
    padding-block: var(--space-section);
  }

  .cta h2 {
    font-size: var(--text-h1);
    max-width: 20ch;
  }

  .cta-action {
    margin-top: 2rem;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
  }

  .cta-action a {
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.1em;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .availability {
    margin-top: 1.4rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-block: 1.4rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }

  .links a:hover {
    color: var(--accent-ink);
  }
</style>
